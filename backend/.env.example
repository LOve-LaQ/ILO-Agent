# Environment Variables for ILO-Agent Demo
# 复制为 .env 后按需填写；.env 不入库（见 .gitignore）

## Chat API Keys (Required for AI chat)
# 任选其一：DeepSeek（默认）/ OpenAI
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
# OPENAI_API_KEY=sk-your-openai-api-key-here

## Embedding API Keys (Optional but recommended)
# 中文内容推荐阿里云百炼
ALIYUN_API_KEY=sk-your-aliyun-dashscope-key-here
# VOYAGE_API_KEY=voy-your-voyage-key-here
# ZHIPU_API_KEY=glm-your-zhipu-key-here

## External Services
REDIS_URL=redis://127.0.0.1:6379/0
QDRANT_URL=http://127.0.0.1:6333

## 下游 LLM 调用超时（秒）
# 超时的意义是「尽快失败并降级」，不是「等到底」——调大只是把雪崩推迟。
# 这些值同时是单次调用上限；SDK 自带的隐式重试已在 create_llm 里关闭（max_retries=0），
# 否则实际耗时会是配置值的数倍。
# 对话 / 讲解：用户在等，必须有界
LLM_CHAT_TIMEOUT=50.0
# 批量摘要：一批 20 条要生成结构化 JSON，天然偏长，但同样必须有界
LLM_SUMMARY_TIMEOUT=95.0
# eval 裁判：仅 `pytest -m eval` 使用
LLM_JUDGE_TIMEOUT=35.0

## 请求级超时预算（秒）：约束「这一次请求总共能花多久」
# 每层各拍一个固定值在链路一长就失效（Redis 1s + PG 3s + LLM 50s = 最坏 54s，
# 还没算重试）。有预算后，重试也受同一个总预算约束。
# 配 0 或负数表示该接口不设预算（便于排查时临时放行）。
DEADLINE_DISCOVER_NEWS_SECONDS=5.0
DEADLINE_CARD_DIGEST_SECONDS=40.0
DEADLINE_LEARNING_CHAT_SECONDS=60.0
DEADLINE_LEARNING_SESSION_SECONDS=15.0
DEADLINE_LEARNING_RESPONSE_SECONDS=60.0

## 下游熔断
# 连续失败达阈值 → 熔断：开放期内不再发起调用。每个请求都去撞一次已挂的下游，
# 只会把「一个下游慢」放大成「整站都在等超时」。
# 状态存 Redis（多实例共享）；Redis 不可用时按「不熔断」处理。
# 配 0 或负数表示该下游不熔断，便于排查时临时放行。
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_OPEN_SECONDS=30

## 各下游单次调用超时（秒）—— 任务书 2.1 超时预算表
# 意义是「尽快失败并降级」，不是「等到底」——调大只是把雪崩推迟。
# Redis：热缓存，宁可快速降级到内存/PG，也不要把请求拖长
REDIS_SOCKET_TIMEOUT=1.0
# PostgreSQL：真相源，语句超时由服务端强制中断（客户端放弃后服务端仍会跑完那条慢查询）
DB_STATEMENT_TIMEOUT_MS=3000
# Qdrant：写档比读档宽 —— 写被掐断要重采，代价比读慢高
QDRANT_TIMEOUT=4.0
QDRANT_WRITE_TIMEOUT=6.0
QDRANT_HEALTH_TIMEOUT=2.0
# Embedding / 外网抓取：均从 30s 收紧
EMBEDDING_TIMEOUT=20.0
FETCH_TIMEOUT=25.0
# 人机校验 / 发信：保持
CAPTCHA_TIMEOUT=5.0
SMTP_TIMEOUT=10.0

## GitHub（「学习先读原文」需要抓取仓库 README）
# 留空：匿名调用 API（60 次/小时，预取会很快耗尽）并自动降级到 raw CDN
# 建议使用仅授予 Contents 只读权限的 fine-grained PAT；.env 不入库
GITHUB_TOKEN=

## Database (阶段 2 用户体系 / 阶段 3 可追溯链路)
# 格式：postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg2://ilo:ilo_dev_2026@127.0.0.1:5432/ilo_agent
DB_ECHO=false

## Auth / JWT (阶段 2 权限边界)
# 必填，且至少 32 字节。生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
REFRESH_COOKIE_NAME=ilo_refresh
# 生产环境（HTTPS）必须置 true
COOKIE_SECURE=false
# 可选：跨子域共享 refresh Cookie 时填写（如 .example.com）
COOKIE_DOMAIN=

## 入口加固（阶段 5）：限流与登录失败锁定
# 限额配 0 或负数表示「该规则不生效」，便于排查时临时放行
RATE_LIMIT_ENABLED=true
REGISTER_RATE_LIMIT_PER_HOUR=5
LOGIN_RATE_LIMIT_IP_PER_15MIN=20
LOGIN_RATE_LIMIT_ACCOUNT_PER_15MIN=10
REFRESH_RATE_LIMIT_PER_HOUR=60
FORGOT_RATE_LIMIT_PER_HOUR=5
FORGOT_EMAIL_RATE_LIMIT_PER_HOUR=3
CAPTCHA_RATE_LIMIT_PER_HOUR=30
EMAIL_RESEND_RATE_LIMIT_PER_HOUR=3
# 原文补抓与中文导读：导读每次未命中缓存都会真实调用 LLM，配额更紧
CARD_CONTENT_RATE_LIMIT_PER_HOUR=60
CARD_DIGEST_RATE_LIMIT_PER_HOUR=30
# 首屏资讯：登录用户会走一次全量候选排序（扫全库向量），需要额度上限
NEWS_RATE_LIMIT_PER_HOUR=600
# 手动抓取（/discover/refresh*）：每次都会打外部 API + 付 LLM 摘要成本，且匿名可触发
DISCOVER_REFRESH_RATE_LIMIT_PER_HOUR=20
# 重置密码：独立的 IP 维度配额，不与 captcha 校验共用一个桶（否则互相抢占）
PASSWORD_RESET_RATE_LIMIT_PER_HOUR=10
# 学习问答（/learning/chat）：每轮都真实调用 LLM，是成本最高的常规接口
LEARNING_CHAT_RATE_LIMIT_PER_HOUR=60
# 撤销注销（/auth/account/delete/cancel）：未登录可调且要校验密码，
# 不设防就会变成绕开登录锁定的口令爆破旁路
ACCOUNT_CANCEL_RATE_LIMIT_PER_HOUR=10
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

## 兴趣向量个性化推送
# 总开关：置 false 后 /discover/news 直接随机抽样，不读画像也不排序
INTEREST_PROFILE_ENABLED=true
# 行为时间衰减半衰期（天）：越久远的行为对画像贡献越小；置 0 表示不衰减
INTEREST_PROFILE_HALF_LIFE_DAYS=14
# 参与构建画像的候选卡片上限（按信号权重取 top-N）
INTEREST_PROFILE_MAX_CANDIDATES=200

## 人机校验（阶段 5）：VAPTCHA V4
# CAPTCHA_PROVIDER=off 只允许在非生产环境；生产环境用 off 会在启动时直接报错
# 需前往 VAPTCHA 后台创建验证单元，拿到 VID（公开）与 KEY（保密）
CAPTCHA_PROVIDER=vaptcha
VAPTCHA_VID=
VAPTCHA_KEY=
VAPTCHA_VERIFY_URL=https://v41.vaptcha.com/api/verify
# 兼容旧配置保留：VAPTCHA V4 校验响应已不再返回 score，当前不参与判定
VAPTCHA_MIN_SCORE=0

## 会话轮换（阶段 5）
# 同一 refresh token 被并发使用（多标签页）时的宽限窗口，避免误判为 token 盗用
SESSION_ROTATE_GRACE_SECONDS=30

## 邮件发信（阶段 5）：找回密码链接 + 注册确认邮件
# console 只把邮件写入 email_outbox 表（开发环境）；上线前改为 smtp 并填 SMTP 账号
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
# 用于拼接链接：{FRONTEND_BASE_URL}/reset-password?token=...
#           与 {FRONTEND_BASE_URL}/verify-email?token=...
FRONTEND_BASE_URL=http://127.0.0.1:5173
PASSWORD_RESET_EXPIRE_MINUTES=30
# 邮箱确认链接有效期；比重置密码长得多，因为它只是让用户发现「邮箱填错了」
EMAIL_VERIFICATION_EXPIRE_HOURS=72

## 账号注销（阶段 5）：冷静期天数，到期执行匿名化清理
ACCOUNT_DELETION_GRACE_DAYS=15

## 个人信息保护（阶段 5）
# IP 落库前用该 secret 做 HMAC-SHA256；留空则**不记录** IP（宁可不记，也不落明文）
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
IP_HASH_SECRET=
ACTIVITY_RETENTION_DAYS=180
SESSION_RETENTION_DAYS=90
EMAIL_OUTBOX_RETENTION_DAYS=30
PASSWORD_RESET_RETENTION_DAYS=7
# 隐私政策 / 用户协议版本号，写入 consent_records
LEGAL_DOCUMENT_VERSION=2026-01

## Optional Keys (for advanced features)
MEM0_API_KEY=your-mem0-api-key
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

## Configuration
LOG_LEVEL=INFO
ENVIRONMENT=development

## CORS 允许来源白名单（逗号分隔）
# 留空时回退到 FRONTEND_BASE_URL；开发期前端走 vite proxy 同源，通常无需配置。
# 切勿配置为 *：refresh token 走 Cookie，来源必须限定。
# 示例：CORS_ALLOW_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
CORS_ALLOW_ORIGINS=
